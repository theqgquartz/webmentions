{
  "name": "@theqgquartz/webmentions",
  "version": "0.1.0",
  "description": "Adds webmentions to pages",
  "type": "module",
  "license": "MIT",
  "author": "David Buchan",
  "homepage": "https://quantumgardener.info",
  "repository": {
    "type": "git",
    "url": "https://github.com/theqgquartz/webmentions"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "content-meta",
    "reading-time",
    "date",
    "component"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "clean": "prettier . --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "preact": "^10.28.2",
    "prettier": "^3.6.2",
    "reading-time": "^1.5.0",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "webmentions",
    "displayName": "Webmentions",
    "category": "transformer",
    "version": "1.0.1",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "showLikes": true,
      "showReposts": true,
      "showReplies": true
    },
    "components": {
      "WebmentionsContent": {
        "displayName": "Webmentsion Content",
        "defaultPosition": "afterBody",
        "defaultPriority": 20
      }
    },
    "optionSchema": {
      "showLikes": {
        "type": "boolean"
      },
      "showReposts": {
        "type": "boolean"
      },
      "showReplies": {
        "type": "boolean"
      }
    }
  }
}
